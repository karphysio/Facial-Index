<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facial Muscle Activity & Symmetry Evaluator</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        teal: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                        },
                        slate: {
                            850: '#1e293b',
                            900: '#0f172a',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome & Lucide Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for radar & visual metrics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- MediaPipe Face Mesh & Camera Utils -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #0d9488;
            border-radius: 3px;
        }
        /* Glassmorphism elements */
        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .pulse-teal {
            box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.7);
            animation: pulse-animation 2s infinite;
        }
        @keyframes pulse-animation {
            0% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(20, 184, 166, 0); }
            100% { box-shadow: 0 0 0 0 rgba(20, 184, 166, 0); }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-900 text-slate-100">

    <!-- Header Navigation -->
    <header class="border-b border-slate-800 bg-slate-900/90 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-teal-500/20 border border-teal-500/40 flex items-center justify-center text-teal-400 font-bold text-xl">
                    <i class="fa-solid fa-face-smile"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-wide text-white">FaceQuant <span class="text-teal-400 font-light text-sm">Clinical AI</span></h1>
                    <p class="text-xs text-slate-400">Bell's Palsy & Facial Nerve Symmetry Grading System</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3">
                <span id="camera-status-badge" class="px-3 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> Initializing Camera
                </span>
                <button id="toggle-demo-btn" class="px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 transition border border-slate-700 flex items-center gap-1.5">
                    <i class="fa-solid fa-sliders text-teal-400"></i> Simulation Mode
                </button>
            </div>
        </div>
    </header>

    <!-- Main App Layout -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Left Column: Video Feed & Task Step Guidance (7 cols) -->
        <section class="lg:col-span-7 flex flex-col gap-6">

            <!-- Video Canvas Stage Card -->
            <div class="glass-card rounded-2xl p-4 flex flex-col gap-4 relative overflow-hidden shadow-2xl">
                <!-- Task Progress Bar -->
                <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden border border-slate-700/50">
                    <div id="protocol-progress-bar" class="bg-gradient-to-r from-teal-500 to-emerald-400 h-full w-[16.6%] transition-all duration-300"></div>
                </div>

                <!-- Guidance Banner Overlay Header -->
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div class="flex items-center gap-2.5">
                        <span id="step-number" class="w-7 h-7 rounded-lg bg-teal-500/20 text-teal-400 border border-teal-500/30 font-bold text-sm flex items-center justify-center">1</span>
                        <div>
                            <h2 id="task-title" class="text-base font-semibold text-white">Baseline Assessment (At Rest)</h2>
                            <p id="task-instruction" class="text-xs text-slate-400">Maintain a neutral, relaxed expression looking directly at the camera.</p>
                        </div>
                    </div>
                    <button id="capture-step-btn" class="px-4 py-2 bg-teal-600 hover:bg-teal-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-teal-900/40 transition flex items-center gap-2 pulse-teal">
                        <i class="fa-solid fa-camera"></i> Record & Next
                    </button>
                </div>

                <!-- Video / Overlay Canvas Container -->
                <div class="relative w-full aspect-video rounded-xl overflow-hidden bg-slate-950 border border-slate-800 flex items-center justify-center group">
                    <!-- Hidden real video element -->
                    <video id="webcam-video" class="hidden" playsinline muted></video>
                    <!-- Display Overlay Canvas -->
                    <canvas id="output-canvas" class="w-full h-full object-cover transform -scale-x-100"></canvas>

                    <!-- Real-time HUD Elements -->
                    <div class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur border border-slate-700/60 rounded-lg px-2.5 py-1 text-[11px] text-slate-300 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Landmark Tracking: <span id="tracking-fps" class="text-teal-400 font-mono">30 FPS</span>
                    </div>

                    <div class="absolute top-3 right-3 flex gap-2">
                        <button id="toggle-mesh-btn" class="bg-slate-900/80 hover:bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1 text-[11px] text-slate-300 transition">
                            <i class="fa-solid fa-eye text-teal-400"></i> Landmarks: ON
                        </button>
                        <button id="toggle-palsy-side-btn" class="bg-slate-900/80 hover:bg-slate-800 border border-slate-700 rounded-lg px-2.5 py-1 text-[11px] text-slate-300 transition">
                            Affected Side: <span id="palsy-side-text" class="text-amber-400 font-bold">Right</span>
                        </button>
                    </div>

                    <!-- Guidance Box Overlay Frame -->
                    <div class="absolute inset-0 border-2 border-dashed border-teal-500/20 rounded-xl pointer-events-none flex items-center justify-center">
                        <div class="w-48 h-64 border border-teal-400/30 rounded-full flex flex-col items-center justify-between py-4 text-teal-400/30 text-[10px] uppercase font-mono tracking-widest">
                            <span>Align Forehead</span>
                            <span>Center Nose</span>
                            <span>Align Chin</span>
                        </div>
                    </div>
                </div>

                <!-- Step Navigator Selector Buttons -->
                <div class="grid grid-cols-6 gap-2">
                    <button data-step="0" class="step-nav-btn active px-2 py-2 rounded-lg text-xs font-medium bg-teal-500/20 text-teal-300 border border-teal-500/50 flex flex-col items-center gap-1 transition">
                        <i class="fa-solid fa-face-meh"></i>
                        <span class="text-[10px] truncate w-full text-center">1. Rest</span>
                    </button>
                    <button data-step="1" class="step-nav-btn px-2 py-2 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700 flex flex-col items-center gap-1 transition hover:bg-slate-750">
                        <i class="fa-solid fa-face-surprise"></i>
                        <span class="text-[10px] truncate w-full text-center">2. Eyebrows</span>
                    </button>
                    <button data-step="2" class="step-nav-btn px-2 py-2 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700 flex flex-col items-center gap-1 transition hover:bg-slate-750">
                        <i class="fa-solid fa-eye-slash"></i>
                        <span class="text-[10px] truncate w-full text-center">3. Close Eyes</span>
                    </button>
                    <button data-step="3" class="step-nav-btn px-2 py-2 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700 flex flex-col items-center gap-1 transition hover:bg-slate-750">
                        <i class="fa-solid fa-face-smile-beam"></i>
                        <span class="text-[10px] truncate w-full text-center">4. Smile</span>
                    </button>
                    <button data-step="4" class="step-nav-btn px-2 py-2 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700 flex flex-col items-center gap-1 transition hover:bg-slate-750">
                        <i class="fa-solid fa-face-grimace"></i>
                        <span class="text-[10px] truncate w-full text-center">5. Snarl</span>
                    </button>
                    <button data-step="5" class="step-nav-btn px-2 py-2 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700 flex flex-col items-center gap-1 transition hover:bg-slate-750">
                        <i class="fa-solid fa-face-kiss-puff"></i>
                        <span class="text-[10px] truncate w-full text-center">6. Puff Cheeks</span>
                    </button>
                </div>
            </div>

            <!-- Real-time Quantitative Muscle Activation Meters -->
            <div class="glass-card rounded-2xl p-5 flex flex-col gap-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                    <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-simple text-teal-400"></i> Real-time Muscle Activation Disparity
                    </h3>
                    <span class="text-[11px] text-slate-400 font-mono">Normal Variance: &lt;10%</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Metric 1: Frontalis (Forehead) -->
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
                        <div class="flex justify-between text-xs mb-1.5">
                            <span class="font-medium text-slate-300">Frontalis (Eyebrow Height)</span>
                            <span id="metric-eyebrow-val" class="font-mono text-teal-400">Diff: 14%</span>
                        </div>
                        <div class="flex items-center gap-2 text-[10px] text-slate-400">
                            <span class="w-8">L: <span id="eyebrow-l" class="font-mono text-slate-200">22px</span></span>
                            <div class="flex-1 bg-slate-800 h-2.5 rounded-full overflow-hidden flex">
                                <div id="bar-eyebrow-l" class="bg-teal-500 h-full w-[50%] border-r border-slate-900"></div>
                                <div id="bar-eyebrow-r" class="bg-amber-500 h-full w-[36%]"></div>
                            </div>
                            <span class="w-8 text-right">R: <span id="eyebrow-r" class="font-mono text-slate-200">14px</span></span>
                        </div>
                    </div>

                    <!-- Metric 2: Orbicularis Oculi (Eye Closure) -->
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
                        <div class="flex justify-between text-xs mb-1.5">
                            <span class="font-medium text-slate-300">Orbicularis Oculi (Aperture)</span>
                            <span id="metric-eye-val" class="font-mono text-teal-400">Diff: 28%</span>
                        </div>
                        <div class="flex items-center gap-2 text-[10px] text-slate-400">
                            <span class="w-8">L: <span id="eye-l" class="font-mono text-slate-200">9px</span></span>
                            <div class="flex-1 bg-slate-800 h-2.5 rounded-full overflow-hidden flex">
                                <div id="bar-eye-l" class="bg-teal-500 h-full w-[65%] border-r border-slate-900"></div>
                                <div id="bar-eye-r" class="bg-amber-500 h-full w-[37%]"></div>
                            </div>
                            <span class="w-8 text-right">R: <span id="eye-r" class="font-mono text-slate-200">14px</span></span>
                        </div>
                    </div>

                    <!-- Metric 3: Zygomaticus Major (Mouth Corner Lift) -->
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
                        <div class="flex justify-between text-xs mb-1.5">
                            <span class="font-medium text-slate-300">Zygomaticus (Smile Excursion)</span>
                            <span id="metric-smile-val" class="font-mono text-teal-400">Diff: 32%</span>
                        </div>
                        <div class="flex items-center gap-2 text-[10px] text-slate-400">
                            <span class="w-8">L: <span id="smile-l" class="font-mono text-slate-200">35px</span></span>
                            <div class="flex-1 bg-slate-800 h-2.5 rounded-full overflow-hidden flex">
                                <div id="bar-smile-l" class="bg-teal-500 h-full w-[70%] border-r border-slate-900"></div>
                                <div id="bar-smile-r" class="bg-amber-500 h-full w-[38%]"></div>
                            </div>
                            <span class="w-8 text-right">R: <span id="smile-r" class="font-mono text-slate-200">19px</span></span>
                        </div>
                    </div>

                    <!-- Metric 4: Orbicularis Oris / Nasolabial (Midface Symmetry) -->
                    <div class="bg-slate-900/60 p-3 rounded-xl border border-slate-800">
                        <div class="flex justify-between text-xs mb-1.5">
                            <span class="font-medium text-slate-300">Nasolabial & Lip Symmetry</span>
                            <span id="metric-mouth-val" class="font-mono text-teal-400">Diff: 18%</span>
                        </div>
                        <div class="flex items-center gap-2 text-[10px] text-slate-400">
                            <span class="w-8">L: <span id="mouth-l" class="font-mono text-slate-200">42px</span></span>
                            <div class="flex-1 bg-slate-800 h-2.5 rounded-full overflow-hidden flex">
                                <div id="bar-mouth-l" class="bg-teal-500 h-full w-[55%] border-r border-slate-900"></div>
                                <div id="bar-mouth-r" class="bg-amber-500 h-full w-[37%]"></div>
                            </div>
                            <span class="w-8 text-right">R: <span id="mouth-r" class="font-mono text-slate-200">34px</span></span>
                        </div>
                    </div>
                </div>
            </div>

        </section>

        <!-- Right Column: Clinical Grading, Synkinesis, & Evaluation Summary (5 cols) -->
        <section class="lg:col-span-5 flex flex-col gap-6">

            <!-- House-Brackmann & Sunnybrook Grading Cards -->
            <div class="glass-card rounded-2xl p-5 flex flex-col gap-5 border-l-4 border-l-teal-500">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <div>
                        <h3 class="font-bold text-base text-white">Clinical Assessment Scores</h3>
                        <p class="text-xs text-slate-400">Computed via facial vector displacement</p>
                    </div>
                    <span id="hb-grade-badge" class="px-3 py-1 rounded-xl text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
                        Grade III (Moderate)
                    </span>
                </div>

                <div class="grid grid-cols-2 gap-3 text-center">
                    <!-- House Brackmann Box -->
                    <div class="bg-slate-900/80 p-3.5 rounded-xl border border-slate-800 flex flex-col items-center justify-center">
                        <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">House-Brackmann Scale</span>
                        <div id="hb-score-display" class="text-3xl font-extrabold text-teal-400 my-1">III <span class="text-sm font-normal text-slate-400">/ VI</span></div>
                        <span id="hb-desc" class="text-[11px] text-slate-300 font-medium">Noticeable asymmetry at movement</span>
                    </div>

                    <!-- Sunnybrook System Box -->
                    <div class="bg-slate-900/80 p-3.5 rounded-xl border border-slate-800 flex flex-col items-center justify-center">
                        <span class="text-[11px] font-medium text-slate-400 uppercase tracking-wider">Sunnybrook Score</span>
                        <div id="sunnybrook-score-display" class="text-3xl font-extrabold text-emerald-400 my-1">62 <span class="text-sm font-normal text-slate-400">/ 100</span></div>
                        <span class="text-[11px] text-slate-300 font-medium">Composite Symmetry Index</span>
                    </div>
                </div>

                <!-- Radar Chart Visualizing Muscle Domain Activation -->
                <div class="w-full h-48 bg-slate-900/40 rounded-xl border border-slate-800/80 p-2 flex items-center justify-center">
                    <canvas id="symmetry-radar-chart"></canvas>
                </div>
            </div>

            <!-- Synkinesis Detection & Involuntary Movement Alert -->
            <div class="glass-card rounded-2xl p-5 flex flex-col gap-3">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-amber-400"></i> Synkinesis & Involuntary Coupling
                    </h3>
                    <span id="synkinesis-risk-tag" class="text-[10px] px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
                        Mild Detected
                    </span>
                </div>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Evaluates unintentional co-contractions during primary facial expressions (e.g., ocular narrowing when smiling).
                </p>

                <div class="space-y-2 mt-1">
                    <div class="bg-slate-900/60 p-2.5 rounded-lg border border-slate-800 flex items-center justify-between text-xs">
                        <span class="text-slate-300">Ocular-Oral Coupling (Eye narrow on smile)</span>
                        <span id="synkinesis-eye-smile" class="font-mono text-amber-400 font-semibold">18% (Mild)</span>
                    </div>
                    <div class="bg-slate-900/60 p-2.5 rounded-lg border border-slate-800 flex items-center justify-between text-xs">
                        <span class="text-slate-300">Oral-Ocular Coupling (Mouth twitch on blink)</span>
                        <span id="synkinesis-mouth-blink" class="font-mono text-emerald-400 font-semibold">4% (Normal)</span>
                    </div>
                </div>
            </div>

            <!-- Snapshot Baseline vs Activation Comparison Preview -->
            <div class="glass-card rounded-2xl p-5 flex flex-col gap-3">
                <h3 class="text-sm font-semibold text-white flex items-center gap-2">
                    <i class="fa-solid fa-images text-teal-400"></i> Task Snapshots (Rest vs Active)
                </h3>
                
                <div class="grid grid-cols-2 gap-3">
                    <div class="bg-slate-950 rounded-lg p-2 border border-slate-800 flex flex-col items-center">
                        <span class="text-[10px] text-slate-400 font-mono mb-1">Step 1: Baseline (Rest)</span>
                        <div class="w-full aspect-video bg-slate-900 rounded overflow-hidden flex items-center justify-center relative">
                            <img id="snapshot-rest" class="w-full h-full object-cover hidden" alt="Rest Frame">
                            <span id="snapshot-rest-placeholder" class="text-[11px] text-slate-600 italic">No capture</span>
                        </div>
                    </div>
                    <div class="bg-slate-950 rounded-lg p-2 border border-slate-800 flex flex-col items-center">
                        <span class="text-[10px] text-slate-400 font-mono mb-1">Step 4: Active (Smile)</span>
                        <div class="w-full aspect-video bg-slate-900 rounded overflow-hidden flex items-center justify-center relative">
                            <img id="snapshot-smile" class="w-full h-full object-cover hidden" alt="Smile Frame">
                            <span id="snapshot-smile-placeholder" class="text-[11px] text-slate-600 italic">No capture</span>
                        </div>
                    </div>
                </div>

                <!-- Export & Clinical Download Action -->
                <div class="pt-2 border-t border-slate-800 flex gap-2">
                    <button id="download-report-btn" class="flex-1 py-2.5 bg-slate-800 hover:bg-slate-700 text-teal-400 border border-teal-500/30 rounded-xl text-xs font-semibold transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-file-arrow-down"></i> Export Clinical Report (JSON)
                    </button>
                    <button id="reset-protocol-btn" class="px-3 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-400 rounded-xl text-xs font-semibold transition">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                </div>
            </div>

            <!-- Non-Diagnostic Clinical Disclaimer -->
            <div class="bg-slate-900/40 rounded-xl p-3 border border-slate-800/60 text-[11px] text-slate-400 flex items-start gap-2">
                <i class="fa-solid fa-circle-info text-teal-400/80 mt-0.5 flex-shrink-0"></i>
                <p>
                    <strong class="text-slate-300">Research & Tracking Disclaimer:</strong> This quantitative AI tool provides assistive numerical tracking of facial symmetry. It is not an automated medical diagnosis. Consult a qualified clinical neurologist or ENT specialist for evaluation.
                </p>
            </div>

        </section>

    </main>

    <!-- Application Script -->
    <script>
        // State Management
        const state = {
            currentStep: 0,
            palsySide: 'right', // 'left' or 'right'
            showLandmarks: true,
            isSimulationMode: false,
            webcamActive: false,
            capturedSnapshots: {},
            fps: 30,
            
            // Standard task definitions
            tasks: [
                { id: 'rest', title: 'Baseline Assessment (At Rest)', instruction: 'Maintain a relaxed, neutral facial expression looking straight ahead.' },
                { id: 'eyebrows', title: 'Raise Eyebrows (Frontalis)', instruction: 'Raise both eyebrows as high as possible to form forehead wrinkles.' },
                { id: 'close_eyes', title: 'Close Eyes Tightly (Orbicularis Oculi)', instruction: 'Squeeze both eyes shut as tightly as possible.' },
                { id: 'smile', title: 'Smile Broadly (Zygomaticus Major)', instruction: 'Smile wide showing teeth, pulling mouth corners upward.' },
                { id: 'snarl', title: 'Snarl / Pucker (Levator Labii / Oris)', instruction: 'Wrinkle nose and elevate upper lip in a snarl.' },
                { id: 'puff_cheeks', title: 'Puff Cheeks (Buccinator)', instruction: 'Fill cheeks with air and hold tight lip seal.' }
            ],

            // Real-time calculated metrics (Pixel distances or normalized indices)
            metrics: {
                eyebrowHeightL: 22, eyebrowHeightR: 14,
                eyeApertureL: 10, eyeApertureR: 14,
                smileExcursionL: 35, smileExcursionR: 19,
                nasolabialL: 42, nasolabialR: 34,
                synkinesisEyeSmile: 18,
                synkinesisMouthBlink: 4
            }
        };

        // MediaPipe & Canvas Elements
        let videoElement, canvasElement, canvasCtx, faceMesh, camera;
        let radarChart;

        // DOM Initialization
        window.onload = async function() {
            initElements();
            initRadarChart();
            setupEventListeners();
            initMediaPipe();
        };

        function initElements() {
            videoElement = document.getElementById('webcam-video');
            canvasElement = document.getElementById('output-canvas');
            canvasCtx = canvasElement.getContext('2d');

            // Responsive Canvas Sizing
            resizeCanvas();
            window.addEventListener('resize', resizeCanvas);
        }

        function resizeCanvas() {
            if (canvasElement && canvasElement.parentElement) {
                canvasElement.width = canvasElement.parentElement.clientWidth;
                canvasElement.height = canvasElement.parentElement.clientHeight;
            }
        }

        // Radar Chart for Symmetry Profile
        function initRadarChart() {
            const ctx = document.getElementById('symmetry-radar-chart').getContext('2d');
            radarChart = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['Forehead (Frontalis)', 'Eye Closure', 'Smile Elevation', 'Lip Seal', 'Midface Tone'],
                    datasets: [
                        {
                            label: 'Left Side (%)',
                            data: [90, 95, 88, 92, 90],
                            fill: true,
                            backgroundColor: 'rgba(20, 184, 166, 0.2)',
                            borderColor: '#14b8a6',
                            pointBackgroundColor: '#14b8a6',
                            borderWidth: 2
                        },
                        {
                            label: 'Right Side (Affected)',
                            data: [55, 60, 48, 70, 62],
                            fill: true,
                            backgroundColor: 'rgba(245, 158, 11, 0.2)',
                            borderColor: '#f59e0b',
                            pointBackgroundColor: '#f59e0b',
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            angleLines: { color: 'rgba(255, 255, 255, 0.1)' },
                            grid: { color: 'rgba(255, 255, 255, 0.1)' },
                            pointLabels: { color: '#94a3b8', font: { size: 10 } },
                            ticks: { display: false, max: 100, min: 0 }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: { color: '#cbd5e1', font: { size: 10 } }
                        }
                    }
                }
            });
        }

        // MediaPipe Face Mesh Setup
        function initMediaPipe() {
            faceMesh = new FaceMesh({
                locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/${file}`
            });

            faceMesh.setOptions({
                maxNumFaces: 1,
                refineLandmarks: true,
                minDetectionConfidence: 0.5,
                minTrackingConfidence: 0.5
            });

            faceMesh.onResults(onFaceMeshResults);

            // Initialize Camera Utility
            camera = new Camera(videoElement, {
                onFrame: async () => {
                    if (!state.isSimulationMode) {
                        await faceMesh.send({ image: videoElement });
                    }
                },
                width: 640,
                height: 480
            });

            camera.start().then(() => {
                state.webcamActive = true;
                updateCameraBadge(true);
            }).catch(err => {
                console.warn('Webcam failed or denied. Falling back to Simulation Mode.', err);
                enableSimulationMode();
            });
        }

        function updateCameraBadge(active) {
            const badge = document.getElementById('camera-status-badge');
            if (active) {
                badge.className = 'px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5';
                badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Webcam Active`;
            } else {
                badge.className = 'px-3 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/30 flex items-center gap-1.5';
                badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400"></span> Demo / Simulation Mode`;
            }
        }

        // Process Face Mesh Results
        function onFaceMeshResults(results) {
            canvasCtx.save();
            canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

            // Draw Source Image Frame
            canvasCtx.drawImage(results.image, 0, 0, canvasElement.width, canvasElement.height);

            if (results.multiFaceLandmarks && results.multiFaceLandmarks.length > 0) {
                const landmarks = results.multiFaceLandmarks[0];

                // Perform Quantitative Metric Calculations
                calculateLandmarkMetrics(landmarks, canvasElement.width, canvasElement.height);

                // Render Visual Facial Mesh Grid & Key Vectors
                if (state.showLandmarks) {
                    drawFacialKeypoints(landmarks, canvasCtx, canvasElement.width, canvasElement.height);
                }
            }

            canvasCtx.restore();
        }

        // Calculation of Clinical Asymmetry Indices
        function calculateLandmarkMetrics(landmarks, width, height) {
            // Helper function to get absolute pixel coords
            const getPt = (idx) => ({
                x: landmarks[idx].x * width,
                y: landmarks[idx].y * height
            });

            // Specific MediaPipe Keypoint Index Anchors
            // Forehead / Eyebrows: Top Eyebrow Left (70), Right (300). Pupil Center Left (468), Right (473)
            const eyebrowL = getPt(70), pupilL = getPt(468);
            const eyebrowR = getPt(300), pupilR = getPt(473);

            // Eye Aperture / Palpebral Fissure: Top Lid (159/386), Bottom Lid (145/374)
            const eyeTopL = getPt(159), eyeBotL = getPt(145);
            const eyeTopR = getPt(386), eyeBotR = getPt(374);

            // Smile Corner Elevation: Mouth Corner Left (61), Right (291), Nose Tip (1)
            const mouthCornerL = getPt(61), mouthCornerR = getPt(291), noseTip = getPt(1);

            // Compute Euclidian Distances
            const eyebrowDistL = Math.hypot(eyebrowL.x - pupilL.x, eyebrowL.y - pupilL.y);
            const eyebrowDistR = Math.hypot(eyebrowR.x - pupilR.x, eyebrowR.y - pupilR.y);

            const eyeApertureL = Math.hypot(eyeTopL.x - eyeBotL.x, eyeTopL.y - eyeBotL.y);
            const eyeApertureR = Math.hypot(eyeTopR.x - eyeBotR.x, eyeTopR.y - eyeBotR.y);

            const smileL = Math.hypot(mouthCornerL.x - noseTip.x, mouthCornerL.y - noseTip.y);
            const smileR = Math.hypot(mouthCornerR.x - noseTip.x, mouthCornerR.y - noseTip.y);

            // Update state metrics with smoothing
            state.metrics.eyebrowHeightL = Math.round(eyebrowDistL);
            state.metrics.eyebrowHeightR = Math.round(eyebrowDistR);
            state.metrics.eyeApertureL = Math.round(eyeApertureL);
            state.metrics.eyeApertureR = Math.round(eyeApertureR);
            state.metrics.smileExcursionL = Math.round(smileL);
            state.metrics.smileExcursionR = Math.round(smileR);

            updateUI();
        }

        // Draw Clinical Overlay Vector Lines
        function drawFacialKeypoints(landmarks, ctx, width, height) {
            ctx.fillStyle = '#14b8a6';
            ctx.strokeStyle = '#0d9488';
            ctx.lineWidth = 1;

            // Highlight Key Anatomical Clusters: Eyebrows, Eyes, Mouth, Midface
            const keyIndices = [
                // Eyebrows
                70, 63, 105, 66, 107, 336, 296, 334, 293, 300,
                // Eye Contours
                33, 160, 158, 133, 153, 144, 362, 385, 387, 263, 373, 380,
                // Mouth & Smile Line
                61, 185, 40, 39, 37, 0, 267, 269, 270, 291, 321, 314, 17, 84, 91
            ];

            keyIndices.forEach(idx => {
                if (landmarks[idx]) {
                    const pt = landmarks[idx];
                    ctx.beginPath();
                    ctx.arc(pt.x * width, pt.y * height, 2, 0, 2 * Math.PI);
                    ctx.fillStyle = idx > 200 ? '#f59e0b' : '#14b8a6'; // Differentiate left vs right side
                    ctx.fill();
                }
            });

            // Draw Midline Reference Symmetry Axis
            const foreheadPt = landmarks[10], chinPt = landmarks[152];
            if (foreheadPt && chinPt) {
                ctx.beginPath();
                ctx.moveTo(foreheadPt.x * width, foreheadPt.y * height);
                ctx.lineTo(chinPt.x * width, chinPt.y * height);
                ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
                ctx.setLineDash([4, 4]);
                ctx.stroke();
                ctx.setLineDash([]);
            }
        }

        // Fallback / Simulation Loop if Webcam is unavailable or demo requested
        function enableSimulationMode() {
            state.isSimulationMode = true;
            updateCameraBadge(false);
            runSimulationLoop();
        }

        function runSimulationLoop() {
            if (!state.isSimulationMode) return;

            // Simulate dynamic facial landmark movement for task evaluation demo
            const time = Date.now() * 0.003;
            const factor = Math.sin(time) * 0.5 + 0.5;

            state.metrics.eyebrowHeightL = 22 + Math.round(factor * 10);
            state.metrics.eyebrowHeightR = 14 + Math.round(factor * 3); // Impaired right side

            state.metrics.eyeApertureL = 10 - Math.round(factor * 6);
            state.metrics.eyeApertureR = 14 - Math.round(factor * 2);

            state.metrics.smileExcursionL = 35 + Math.round(factor * 15);
            state.metrics.smileExcursionR = 19 + Math.round(factor * 4);

            updateUI();
            drawSimulationCanvas();

            requestAnimationFrame(runSimulationLoop);
        }

        function drawSimulationCanvas() {
            canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

            // Draw background placeholder face silhouette
            canvasCtx.fillStyle = '#1e293b';
            canvasCtx.fillRect(0, 0, canvasElement.width, canvasElement.height);

            const cx = canvasElement.width / 2;
            const cy = canvasElement.height / 2;

            // Draw Head Contour
            canvasCtx.beginPath();
            canvasCtx.ellipse(cx, cy, 110, 150, 0, 0, 2 * Math.PI);
            canvasCtx.strokeStyle = '#334155';
            canvasCtx.lineWidth = 3;
            canvasCtx.stroke();

            // Draw Eyebrows (Left vs Right asymmetry)
            canvasCtx.strokeStyle = '#14b8a6';
            canvasCtx.beginPath();
            canvasCtx.moveTo(cx - 70, cy - 60 - (state.metrics.eyebrowHeightL - 22));
            canvasCtx.lineTo(cx - 20, cy - 55 - (state.metrics.eyebrowHeightL - 22));
            canvasCtx.stroke();

            canvasCtx.strokeStyle = '#f59e0b';
            canvasCtx.beginPath();
            canvasCtx.moveTo(cx + 20, cy - 55 - (state.metrics.eyebrowHeightR - 14));
            canvasCtx.lineTo(cx + 70, cy - 60 - (state.metrics.eyebrowHeightR - 14));
            canvasCtx.stroke();

            // Draw Eyes
            canvasCtx.fillStyle = '#94a3b8';
            canvasCtx.beginPath();
            canvasCtx.ellipse(cx - 40, cy - 30, 15, state.metrics.eyeApertureL / 2, 0, 0, 2 * Math.PI);
            canvasCtx.ellipse(cx + 40, cy - 30, 15, state.metrics.eyeApertureR / 2, 0, 0, 2 * Math.PI);
            canvasCtx.fill();

            // Draw Mouth / Smile Curve
            canvasCtx.beginPath();
            canvasCtx.moveTo(cx - (state.metrics.smileExcursionL), cy + 50);
            canvasCtx.quadraticCurveTo(cx, cy + 65, cx + (state.metrics.smileExcursionR), cy + 55);
            canvasCtx.strokeStyle = '#f8fafc';
            canvasCtx.lineWidth = 4;
            canvasCtx.stroke();

            // Text tag overlay
            canvasCtx.fillStyle = '#0d9488';
            canvasCtx.font = '12px Inter';
            canvasCtx.fillText('SIMULATED CLINICAL PATIENT FEED', 15, 25);
        }

        // Update UI Text, Meters, and Clinical Scores
        function updateUI() {
            const m = state.metrics;

            // Eyebrow Metric UI
            document.getElementById('eyebrow-l').innerText = `${m.eyebrowHeightL}px`;
            document.getElementById('eyebrow-r').innerText = `${m.eyebrowHeightR}px`;
            const eyebrowDiff = Math.abs(m.eyebrowHeightL - m.eyebrowHeightR);
            const eyebrowPerc = Math.round((eyebrowDiff / Math.max(m.eyebrowHeightL, 1)) * 100);
            document.getElementById('metric-eyebrow-val').innerText = `Diff: ${eyebrowPerc}%`;

            // Eye Aperture UI
            document.getElementById('eye-l').innerText = `${m.eyeApertureL}px`;
            document.getElementById('eye-r').innerText = `${m.eyeApertureR}px`;
            const eyeDiff = Math.abs(m.eyeApertureL - m.eyeApertureR);
            const eyePerc = Math.round((eyeDiff / Math.max(m.eyeApertureL, 1)) * 100);
            document.getElementById('metric-eye-val').innerText = `Diff: ${eyePerc}%`;

            // Smile UI
            document.getElementById('smile-l').innerText = `${m.smileExcursionL}px`;
            document.getElementById('smile-r').innerText = `${m.smileExcursionR}px`;
            const smileDiff = Math.abs(m.smileExcursionL - m.smileExcursionR);
            const smilePerc = Math.round((smileDiff / Math.max(m.smileExcursionL, 1)) * 100);
            document.getElementById('metric-smile-val').innerText = `Diff: ${smilePerc}%`;

            // House-Brackmann Score Calculation Logic
            const avgAsymmetry = (eyebrowPerc + eyePerc + smilePerc) / 3;
            let hbGrade = 'Grade I';
            let hbText = 'Normal symmetry & function';
            let hbBadgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40';

            if (avgAsymmetry > 45) {
                hbGrade = 'Grade V (Severe)';
                hbText = 'Barely perceptible movement';
                hbBadgeClass = 'bg-red-500/20 text-red-300 border-red-500/40';
            } else if (avgAsymmetry > 35) {
                hbGrade = 'Grade IV (Mod. Severe)';
                hbText = 'Obvious asymmetry, incomplete closure';
                hbBadgeClass = 'bg-orange-500/20 text-orange-300 border-orange-500/40';
            } else if (avgAsymmetry > 20) {
                hbGrade = 'Grade III (Moderate)';
                hbText = 'Noticeable asymmetry with full closure';
                hbBadgeClass = 'bg-amber-500/20 text-amber-300 border-amber-500/40';
            } else if (avgAsymmetry > 10) {
                hbGrade = 'Grade II (Mild)';
                hbText = 'Slight asymmetry on close inspection';
                hbBadgeClass = 'bg-teal-500/20 text-teal-300 border-teal-500/40';
            }

            document.getElementById('hb-score-display').innerHTML = `${hbGrade.split(' ')[1]} <span class="text-sm font-normal text-slate-400">/ VI</span>`;
            document.getElementById('hb-desc').innerText = hbText;
            document.getElementById('hb-grade-badge').className = `px-3 py-1 rounded-xl text-xs font-bold border ${hbBadgeClass}`;
            document.getElementById('hb-grade-badge').innerText = hbGrade;

            // Sunnybrook Composite Estimate Calculation
            const sunnybrookScore = Math.max(10, Math.min(100, Math.round(100 - avgAsymmetry * 1.2)));
            document.getElementById('sunnybrook-score-display').innerHTML = `${sunnybrookScore} <span class="text-sm font-normal text-slate-400">/ 100</span>`;

            // Update Radar Chart Dataset
            if (radarChart) {
                const rightScores = [
                    Math.max(20, 100 - eyebrowPerc),
                    Math.max(20, 100 - eyePerc),
                    Math.max(20, 100 - smilePerc),
                    80, 75
                ];
                radarChart.data.datasets[1].data = rightScores;
                radarChart.update('none');
            }
        }

        // Setup Buttons & Event Handlers
        function setupEventListeners() {
            // Step Task Navigator Buttons
            document.querySelectorAll('.step-nav-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const stepIdx = parseInt(btn.getAttribute('data-step'));
                    switchTaskStep(stepIdx);
                });
            });

            // Capture Step / Record Button
            document.getElementById('capture-step-btn').addEventListener('click', captureCurrentStep);

            // Toggle Palsy Side
            document.getElementById('toggle-palsy-side-btn').addEventListener('click', () => {
                state.palsySide = state.palsySide === 'right' ? 'left' : 'right';
                document.getElementById('palsy-side-text').innerText = state.palsySide === 'right' ? 'Right' : 'Left';
                document.getElementById('palsy-side-text').className = state.palsySide === 'right' ? 'text-amber-400 font-bold' : 'text-teal-400 font-bold';
            });

            // Toggle Mesh Visiblity
            document.getElementById('toggle-mesh-btn').addEventListener('click', () => {
                state.showLandmarks = !state.showLandmarks;
                document.getElementById('toggle-mesh-btn').innerHTML = state.showLandmarks ? 
                    `<i class="fa-solid fa-eye text-teal-400"></i> Landmarks: ON` : 
                    `<i class="fa-solid fa-eye-slash text-slate-400"></i> Landmarks: OFF`;
            });

            // Toggle Simulation Mode
            document.getElementById('toggle-demo-btn').addEventListener('click', () => {
                state.isSimulationMode = !state.isSimulationMode;
                if (state.isSimulationMode) {
                    enableSimulationMode();
                } else {
                    state.isSimulationMode = false;
                    updateCameraBadge(state.webcamActive);
                }
            });

            // Export Clinical Report
            document.getElementById('download-report-btn').addEventListener('click', exportClinicalReport);

            // Reset Protocol
            document.getElementById('reset-protocol-btn').addEventListener('click', () => {
                switchTaskStep(0);
                state.capturedSnapshots = {};
                document.getElementById('snapshot-rest').classList.add('hidden');
                document.getElementById('snapshot-rest-placeholder').classList.remove('hidden');
                document.getElementById('snapshot-smile').classList.add('hidden');
                document.getElementById('snapshot-smile-placeholder').classList.remove('hidden');
            });
        }

        function switchTaskStep(stepIdx) {
            state.currentStep = stepIdx;
            const task = state.tasks[stepIdx];

            // Update Header Information
            document.getElementById('step-number').innerText = stepIdx + 1;
            document.getElementById('task-title').innerText = task.title;
            document.getElementById('task-instruction').innerText = task.instruction;

            // Progress Bar
            const pct = ((stepIdx + 1) / state.tasks.length) * 100;
            document.getElementById('protocol-progress-bar').style.width = `${pct}%`;

            // Active State on Nav Buttons
            document.querySelectorAll('.step-nav-btn').forEach((btn, idx) => {
                if (idx === stepIdx) {
                    btn.className = 'step-nav-btn active px-2 py-2 rounded-lg text-xs font-medium bg-teal-500/20 text-teal-300 border border-teal-500/50 flex flex-col items-center gap-1 transition';
                } else {
                    btn.className = 'step-nav-btn px-2 py-2 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700 flex flex-col items-center gap-1 transition hover:bg-slate-750';
                }
            });
        }

        function captureCurrentStep() {
            const dataUrl = canvasElement.toDataURL('image/png');
            const stepId = state.tasks[state.currentStep].id;
            state.capturedSnapshots[stepId] = dataUrl;

            // Render Preview Snapshots if applicable
            if (stepId === 'rest') {
                const img = document.getElementById('snapshot-rest');
                img.src = dataUrl;
                img.classList.remove('hidden');
                document.getElementById('snapshot-rest-placeholder').classList.add('hidden');
            } else if (stepId === 'smile') {
                const img = document.getElementById('snapshot-smile');
                img.src = dataUrl;
                img.classList.remove('hidden');
                document.getElementById('snapshot-smile-placeholder').classList.add('hidden');
            }

            // Move to next step if not last
            if (state.currentStep < state.tasks.length - 1) {
                switchTaskStep(state.currentStep + 1);
            }
        }

        // Export JSON Clinical Assessment File
        function exportClinicalReport() {
            const reportData = {
                timestamp: new Date().toISOString(),
                patientSideAffected: state.palsySide,
                houseBrackmannScore: document.getElementById('hb-grade-badge').innerText,
                sunnybrookScore: document.getElementById('sunnybrook-score-display').innerText.trim(),
                asymmetryMetrics: state.metrics,
                completedTasks: Object.keys(state.capturedSnapshots)
            };

            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(reportData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `Bells_Palsy_Assessment_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }
    </script>
